# Required bootstrap credentials. Change before first start.
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional bootstrap values. They can later be changed in /admin/settings.
APP_NAME=Snipe Bridge
TERMINAL_TITLE=SNIPE BRIDGE
ORGANIZATION_NAME=Your organization
APP_LANGUAGE=en
LOGIN_DESCRIPTION_ENABLED=true
LOGIN_DESCRIPTION_PL=Podłącz ręczny skaner kodów do Snipe-IT i przyśpiesz wydania oraz zwroty
LOGIN_DESCRIPTION_EN=Connect a handheld barcode scanner to Snipe-IT and speed up checkouts and returns
SHOW_IDENTITY_CONFIG_WARNING=true
PRIMARY_COLOR=#FFCD05
HEADER_COLOR=#202124
SNIPEIT_BASE_URL=https://snipe.example.org
SNIPEIT_API_TOKEN=
SNIPEIT_CUSTOM_FIELD=
SNIPEIT_STATUS_CHECKOUT=Deployed
SNIPEIT_STATUS_READY=Ready to Deploy
SNIPEIT_STATUS_SERVICE=Pending

# Optional OpenID Connect login (Google, Entra ID, Keycloak, Authentik,
# Okta, or another standards-compliant provider).
IDENTITY_PROVIDER_TYPE=generic
IDENTITY_PROVIDER_NAME=Company SSO
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://bridge.example.org/auth/oidc/callback
IDENTITY_ALLOWED_DOMAINS=example.org
OIDC_SCOPES=openid profile email
OIDC_EMAIL_CLAIM=email
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=
ADMIN_EMAILS=admin@example.org

DEVICE_LABEL=Scanner-01
DATABASE_PATH=/data/bridge.db
LOGO_PATH=/data/branding/logo
PORT=8080
ASSET_IMAGES_ENABLED=true
TERMINAL_SAFE_MODE=false
PAIR_TTL_MINUTES=15
QR_PAIR_TTL_MINUTES=2
TERMINAL_IDLE_MINUTES=15
REQUEST_TIMEOUT_SECONDS=12
STATUS_CACHE_SECONDS=300
VERIFY_TLS=true
TRUST_PROXY=true
SESSION_COOKIE_SECURE=true
TERMINAL_COOKIE_SECURE=false
CSRF_ENABLED=true
REQUIRE_SECURE_CONFIG=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=900
PAIR_MAX_ATTEMPTS=10
PAIR_WINDOW_SECONDS=300
PAIR_BLOCK_SECONDS=600
SQLITE_BUSY_TIMEOUT_SECONDS=10
SQLITE_WAL_ENABLED=true
AUDIT_RETENTION_DAYS=365
TERMINAL_RETENTION_DAYS=90
DATABASE_BACKUP_DIR=/data/backups
DATABASE_BACKUP_INTERVAL_HOURS=24
DATABASE_BACKUP_KEEP=7
TERMINAL_OPERATION_LOCK_SECONDS=120
READINESS_CHECK_SNIPEIT=false
